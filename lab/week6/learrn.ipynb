   "source": [
    "with open(\"file.txt\", \"r\", encoding=\"utf-8\") as f:\n",
    "    line = f.readline().strip()\n",
    "    print(line.strip())\n",
    "\n",
    "line = f.readline().strip()\n",
    "while line != \"\":\n",
    "    print(line)\n",
    "    line = f.readline().strip()"
